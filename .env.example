# 复制本文件为 .env 填真实值，.env 不要提交 git

LLM_API_KEY=sk-xxxxxxxxxxxx

# API 地址（选一个）
# 通义:     https://dashscope.aliyun.com/compatible-mode/v1
# DeepSeek: https://api.deepseek.com
# 本地Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://dashscope.aliyun.com/compatible-mode/v1

# 模型名（例：qwen-plus / deepseek-chat / deepseek-r1:7b）
LLM_MODEL=qwen-plus
